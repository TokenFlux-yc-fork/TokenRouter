#!/bin/bash

set -euo pipefail

[[ "${1-}" == "-extract" ]]
path=${2:?missing extraction path}
format=${3:?missing output format}
[[ "${4-}" == "-o" ]]
[[ "${5-}" == "-" ]]
[[ "${6-}" == "-" ]]

python3 -c '
import json
import sys

value = json.load(sys.stdin)
for component in sys.argv[1].split("."):
    if isinstance(value, list):
        value = value[int(component)]
    else:
        value = value[component]

if sys.argv[2] == "json":
    json.dump(value, sys.stdout, separators=(",", ":"))
    sys.stdout.write("\n")
else:
    print(value)
' "${path}" "${format}"
